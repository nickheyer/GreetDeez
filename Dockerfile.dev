# ── Stage 1: Build ───────────────────────────────────────────
FROM archlinux:latest AS build

RUN pacman -Syu --noconfirm && pacman -S --noconfirm \
    webkit2gtk webkit2gtk-4.1 \
    go npm pkgconf \
    rust cargo git \
    && pacman -Scc --noconfirm

# Build greetd-stub
RUN cargo install --git https://github.com/apognu/greetd-stub --root /usr/local

# Build greetdeez
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN cd ui/greetdeez && npm ci && npm run build
RUN CGO_ENABLED=1 go build -o bin/greetdeez ./cmd/greetdeez

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM archlinux:latest

RUN pacman -Syu --noconfirm && pacman -S --noconfirm \
    sway wayvnc \
    webkit2gtk webkit2gtk-4.1 \
    mesa \
    && pacman -Scc --noconfirm

# Strip file capabilities from sway so it can exec in a container
RUN setcap -r /usr/sbin/sway 2>/dev/null || true

# Minimal sway config — disable bar, background, xwayland
RUN mkdir -p /root/.config/sway && printf '\
xwayland disable\n\
bar {\n\
    mode invisible\n\
}\n\
output * bg #000000 solid_color\n\
' > /root/.config/sway/config

ENV XDG_RUNTIME_DIR=/run/user/1000
RUN mkdir -p $XDG_RUNTIME_DIR && chmod 700 $XDG_RUNTIME_DIR

# Copy built artifacts from build stage
COPY --from=build /usr/local/bin/greetd-stub /usr/local/bin/greetd-stub
COPY --from=build /app/bin/greetdeez /app/greetdeez

COPY scripts/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

WORKDIR /app
EXPOSE 5910

ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
